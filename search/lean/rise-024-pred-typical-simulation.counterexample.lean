`-0.10 + 0.6688 t`. -/
theorem slow_rise_trajectory :
    ∃ v : ℝ → ℝ, v 0 = -0.10 ∧
      IsTrajectory illustrative slowUpCorner (fun _ => 0.40) v 0 10 ∧
      ∀ t ∈ Icc (0 : ℝ) 10, v t ≤ -0.10 + 0.6688 * t := by
