import VoltageToBit.Examples.Illustrative

/-!
# Refined deadlines for the illustrative inverter (the accepted search result)

The closed-form deadlines of the record are 3.43 ns (rise) and 2.57 ns (fall).
Two 16-level certificates found by workstream F's search loop
(`docs/experiment-loop.md`; records `rise-017-dp-n16` and `fall-016-dp-n16` in
`evidence/search/records.jsonl`) prove **2.26 ns** and **1.425 ns** for the same
circuit, the same parameter box, the same thresholds, the same safe domain, the
same capacitance range and the same `eps`. Only the proof-side list of levels is
new; the proposer of the lists is not trusted, and their validity is the
arithmetic checked below.

What improved is a proved bound for the same model under the same assumptions.
The circuit did not get faster and no physical evidence was added. The search
record also contains 64-level certificates with 2.2533 ns and 1.4193 ns; the
16-level ones are kept here because they are short enough to read.

`Examples/Limits.lean` gives the matching lower limits: no deadline below
2.168 ns (rise) or 1.0234 ns (fall) is valid for this record.

The statements were generated by `search/probe_main.py` and ported here.
-/

namespace VoltageToBit.Examples

open Set

/-- 16-level rising certificate (record `rise-017-dp-n16`): rise deadline `2.26` ns. -/
theorem illustrative_riseCert_16 :
    illustrative.ValidRiseCert 1.001
      [1.055, 1.094, 1.126, 1.154, 1.18, 1.203, 1.224, 1.244, 1.262, 1.279, 1.295, 1.31, 1.324,
      1.337, 1.35]
      2.26 := by
  refine ⟨?_, ?_, ?_⟩ <;>
    norm_num [RiseSegs, finalLevel, riseTime, Design.upSegs, Design.Iup, illustrative,
      psq_eq_ite]

/-- 16-level falling certificate (record `fall-016-dp-n16`): fall deadline `1.425` ns. -/
theorem illustrative_fallCert_16 :
    illustrative.ValidFallCert 0.648
      [0.584, 0.538, 0.5, 0.467, 0.437, 0.41, 0.386, 0.364, 0.344, 0.325, 0.308, 0.292, 0.277,
      0.263, 0.25]
      1.425 := by
  refine ⟨?_, ?_, ?_⟩ <;>
    norm_num [FallSegs, finalLevel, fallTime, Design.dnSegs, Design.Idn, illustrative,
      psq_eq_ite]

/-- **Universal guarantee with the refined deadlines.** Same statement as
`illustrative_guarantee`, with `3.43` ns replaced by `2.26` ns and `2.57` ns
replaced by `1.425` ns. -/
theorem illustrative_guarantee_refined (u v : ℝ → ℝ)
    (a b : ℝ) (h : IsTrajectory illustrative u v a b) (h0 : v a ∈ Icc (-0.10 : ℝ) 2.08) :
    (∀ t ∈ Icc a b, v t ∈ Icc (-0.10 : ℝ) 2.08) ∧
    (∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, u t ≤ 0.40) →
      ∀ t ∈ Icc s e, s + 2.26 ≤ t → 1.35 ≤ v t) ∧
    (∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, 1.25 ≤ u t) →
      ∀ t ∈ Icc s e, s + 1.425 ≤ t → v t ≤ 0.25) := by
  have hsafe : illustrative.Safe = Icc (-0.10 : ℝ) 2.08 := by
    norm_num [Design.Safe, illustrative]
  have h0' : v a ∈ illustrative.Safe := by rw [hsafe]; exact h0
  refine ⟨fun t ht => ?_, fun s e hs he hu t ht htime => ?_, fun s e hs he hu t ht htime => ?_⟩
  · rw [← hsafe]
    exact h.safe illustrative_admissible h0' t ht
  · have := h.rise_of_cert illustrative_admissible h0' illustrative_riseCert_16 hs he
      (fun x hx => by simpa [illustrative] using hu x hx) t ht htime
    simpa [illustrative] using this
  · have := h.fall_of_cert illustrative_admissible h0' illustrative_fallCert_16 hs he
      (fun x hx => by simpa [illustrative] using hu x hx) t ht htime
    simpa [illustrative] using this

end VoltageToBit.Examples
