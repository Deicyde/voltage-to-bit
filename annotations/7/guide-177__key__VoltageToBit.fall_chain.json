          "snippet": {
            "line": 236,
            "text": "theorem fall_chain {v v' : ℝ → ℝ} {a b : ℝ}\n    (hv : ContinuousOn v (Icc a b))\n    (hv' : ∀ t ∈ Ico a b, HasDerivWithinAt v (v' t) (Ici t) t) :\n    ∀ (rest : List (ℝ × ℝ)) (c m h s : ℝ), FallSegs h ((c, m) :: rest) →\n      (∀ p ∈ (c, m) :: rest, ∀ t ∈ Ico a b, p.1 ≤ v t → v' t ≤ -p.2) →\n      s ∈ Icc a b → v s ≤ h →\n      ∀ t ∈ Icc s b, s + fallTime h ((c, m) :: rest) ≤ t →\n        v t ≤ finalLevel h ((c, m) :: rest) := by"
          },
          "declaration": {
            "id": "VoltageToBit.fall_chain",
            "kind": "theorem"
          }
        }
      }
