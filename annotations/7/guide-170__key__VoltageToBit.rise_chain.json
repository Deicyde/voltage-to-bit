          "snippet": {
            "line": 151,
            "text": "theorem rise_chain {v v' : ℝ → ℝ} {a b : ℝ}\n    (hv : ContinuousOn v (Icc a b))\n    (hv' : ∀ t ∈ Ico a b, HasDerivWithinAt v (v' t) (Ici t) t) :\n    ∀ (rest : List (ℝ × ℝ)) (c m l s : ℝ), RiseSegs l ((c, m) :: rest) →\n      (∀ p ∈ (c, m) :: rest, ∀ t ∈ Ico a b, v t ≤ p.1 → p.2 ≤ v' t) →\n      s ∈ Icc a b → l ≤ v s →\n      ∀ t ∈ Icc s b, s + riseTime l ((c, m) :: rest) ≤ t →\n        finalLevel l ((c, m) :: rest) ≤ v t := by"
          },
          "declaration": {
            "id": "VoltageToBit.rise_chain",
            "kind": "theorem"
          }
        }
      }
