          "snippet": {
            "line": 133,
            "text": "theorem RiseSegs.mem_le_finalLevel :\n    ∀ {segs : List (ℝ × ℝ)} {l : ℝ}, RiseSegs l segs → ∀ p ∈ segs, p.1 ≤ finalLevel l segs\n  | [], _, _, p, hp => by simp at hp\n  | (c, m) :: rest, _, h, p, hp => by\n    rcases List.mem_cons.mp hp with rfl | hp'\n    · exact RiseSegs.le_finalLevel h.2.2\n    · exact RiseSegs.mem_le_finalLevel h.2.2 p hp'"
          },
          "declaration": {
            "id": "VoltageToBit.RiseSegs.mem_le_finalLevel",
            "kind": "theorem"
          }
        }
