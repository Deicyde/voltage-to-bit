          "snippet": {
            "line": 218,
            "text": "theorem FallSegs.finalLevel_le_mem :\n    ∀ {segs : List (ℝ × ℝ)} {h : ℝ}, FallSegs h segs → ∀ p ∈ segs, finalLevel h segs ≤ p.1\n  | [], _, _, p, hp => by simp at hp\n  | (c, m) :: rest, _, hs, p, hp => by\n    rcases List.mem_cons.mp hp with rfl | hp'\n    · exact FallSegs.finalLevel_le hs.2.2\n    · exact FallSegs.finalLevel_le_mem hs.2.2 p hp'"
          },
          "declaration": {
            "id": "VoltageToBit.FallSegs.finalLevel_le_mem",
            "kind": "theorem"
          }
