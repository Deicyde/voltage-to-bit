          "snippet": {
            "line": 211,
            "text": "theorem FallSegs.finalLevel_le :\n    ∀ {segs : List (ℝ × ℝ)} {h : ℝ}, FallSegs h segs → finalLevel h segs ≤ h\n  | [], _, _ => le_rfl\n  | (c, _) :: rest, h, hs => by\n    show finalLevel c rest ≤ h\n    exact le_trans (FallSegs.finalLevel_le hs.2.2) hs.1"
          },
