            "text": "theorem rderiv_ge_of_right_nhd {v : ℝ → ℝ} {t0 δ m d0 : ℝ} (hδ : 0 < δ)\n    (hcont : ContinuousOn v (Icc t0 (t0 + δ)))\n    (h0 : HasDerivWithinAt v d0 (Ici t0) t0)\n    (hder : ∀ t ∈ Ioo t0 (t0 + δ), ∃ d, HasDerivWithinAt v d (Ici t) t ∧ m ≤ d) :\n    m ≤ d0 := by"
