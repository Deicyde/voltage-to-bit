            "text": "theorem exists_rise_run (hD : D.Admissible) :\n    ∃ u v : ℝ → ℝ, IsTrajectory D u v 0 (D.tauUp + 1) ∧\n      v 0 = D.VOL ∧ (∀ t, u t ≤ D.VIL) ∧\n      ∀ t ∈ Icc D.tauUp (D.tauUp + 1), D.VOH ≤ v t := by"
