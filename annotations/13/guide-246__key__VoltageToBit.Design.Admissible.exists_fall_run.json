            "line": 84,
            "text": "theorem exists_fall_run (hD : D.Admissible) :\n    ∃ u v : ℝ → ℝ, IsTrajectory D u v 0 (D.tauDn + 1) ∧\n      v 0 = D.VOH ∧ (∀ t, D.VIH ≤ u t) ∧\n      ∀ t ∈ Icc D.tauDn (D.tauDn + 1), v t ≤ D.VOL := by"
