            "line": 387,
            "text": "theorem step_input_scope :\n    (uStepL 4 = 1.8 ∧ uStepR 4 = 0 ∧ ∀ t : ℝ, t ≠ 4 → uStepL t = uStepR t) ∧\n    (¬ ∃ v : ℝ → ℝ, v 0 ∈ Icc (-0.10 : ℝ) 2.08 ∧ IsTrajectory illustrative uStepL v 0 10) ∧\n    (∀ v₀ ∈ Icc (-0.10 : ℝ) 2.08,\n      ∃ v : ℝ → ℝ, v 0 = v₀ ∧ IsTrajectory illustrative uStepR v 0 10) := by"
          }
