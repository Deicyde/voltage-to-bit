          "snippet": {
            "line": 83,
            "text": "theorem chain_restores_low {D : Design} (hD : D.Admissible)\n    (h₁ : IsTrajectory D u v₁ a b) (h₂ : IsTrajectory D v₁ v₂ a b)\n    (h₁0 : v₁ a ∈ D.Safe) (h₂0 : v₂ a ∈ D.Safe) {s e : ℝ} (hs : a ≤ s) (he : e ≤ b)\n    (hu : ∀ t ∈ Ico s e, u t ≤ D.VIL) :\n    ∀ t ∈ Icc s e, s + D.tauUp + D.tauDn ≤ t → v₂ t ≤ D.VOL :="
          },
