            "line": 118,
            "text": "theorem chain_witness_high :\n    ∃ u v₁ v₂ : ℝ → ℝ, (∀ t, 1.25 ≤ u t) ∧\n      IsTrajectory illustrative u v₁ 0 10 ∧ IsTrajectory illustrative v₁ v₂ 0 10 ∧\n      v₁ 0 = 1 ∧ v₂ 0 = 1 ∧\n      (∀ t ∈ Icc (2.57 : ℝ) 10, v₁ t ≤ 0.25) ∧ ∀ t ∈ Icc (6 : ℝ) 10, 1.35 ≤ v₂ t := by"
          },
