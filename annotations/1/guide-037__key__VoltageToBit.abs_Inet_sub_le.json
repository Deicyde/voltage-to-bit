          "snippet": {
            "line": 188,
            "text": "theorem abs_Inet_sub_le (θ : Params) (hkn : 0 ≤ θ.kn) (hkp : 0 ≤ θ.kp) (u v₁ v₂ : ℝ) :\n    |Inet θ u v₁ - Inet θ u v₂| ≤\n      (θ.kp / 2 * (|v₁ - u - θ.Vtp| + |v₂ - u - θ.Vtp|)\n        + θ.kn / 2 * (|u - v₁ - θ.Vtn| + |u - v₂ - θ.Vtn|)) * |v₁ - v₂| := by"
          },
