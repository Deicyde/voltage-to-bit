          "snippet": {
            "line": 47,
            "text": "theorem rise_by {v v' : ℝ → ℝ} {a b c l m : ℝ}\n    (hv : ContinuousOn v (Icc a b))\n    (hv' : ∀ t ∈ Ico a b, HasDerivWithinAt v (v' t) (Ici t) t)\n    (hm : 0 < m) (hl : l ≤ v a)\n    (hslope : ∀ t ∈ Ico a b, v t ≤ c → m ≤ v' t) :\n    ∀ t ∈ Icc a b, a + (c - l) / m ≤ t → c ≤ v t := by"
          },
          "declaration": {
