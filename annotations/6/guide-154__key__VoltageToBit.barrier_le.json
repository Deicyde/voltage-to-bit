            "line": 22,
            "text": "theorem barrier_le {v v' : ℝ → ℝ} {a b c : ℝ}\n    (hv : ContinuousOn v (Icc a b))\n    (hv' : ∀ t ∈ Ico a b, HasDerivWithinAt v (v' t) (Ici t) t)\n    (ha : v a ≤ c)\n    (hbound : ∀ t ∈ Ico a b, v t = c → v' t < 0) :\n    ∀ t ∈ Icc a b, v t ≤ c := by"
