          "snippet": {
            "line": 200,
            "text": "structure IsTrajectory (D : Design) (u v : ℝ → ℝ) (a b : ℝ) : Prop where\n  cont : ContinuousOn v (Icc a b)\n  incl : ∀ t ∈ Ico a b, ∃ v' c : ℝ, HasDerivWithinAt v v' (Ici t) t ∧\n    D.Clo ≤ c ∧ c ≤ D.Chi ∧\n    (v t ∈ D.Safe → ∃ θ : Params, D.InBox θ ∧ |c * v' - Inet θ (u t) (v t)| ≤ D.eps)"
          }
        }
      }
    }
  ],
