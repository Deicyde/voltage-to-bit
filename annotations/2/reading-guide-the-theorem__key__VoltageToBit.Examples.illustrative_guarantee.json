          },
          "snippet": {
            "line": 93,
            "text": "theorem illustrative_guarantee (u v : ℝ → ℝ)\n    (a b : ℝ) (h : IsTrajectory illustrative u v a b) (h0 : v a ∈ Icc (-0.10 : ℝ) 2.08) :\n    (∀ t ∈ Icc a b, v t ∈ Icc (-0.10 : ℝ) 2.08) ∧\n    (∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, u t ≤ 0.40) →\n      ∀ t ∈ Icc s e, s + 3.43 ≤ t → 1.35 ≤ v t) ∧\n    (∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, 1.25 ≤ u t) →\n      ∀ t ∈ Icc s e, s + 2.57 ≤ t → v t ≤ 0.25) := by"
          }
        }
      }
    }
