            "text": "theorem slope_up (hD : D.Admissible) (h : IsTrajectory D u v a b)\n    (h0 : v a ∈ D.Safe) {c t : ℝ} (hc : c ≤ D.VDDlo) (hmargin : D.eps < D.Iup c)\n    (ht : t ∈ Ico a b) (hu : u t ≤ D.VIL) (hv : v t ≤ c) :\n    (D.Iup c - D.eps) / D.Chi ≤ rderiv v t := by"
