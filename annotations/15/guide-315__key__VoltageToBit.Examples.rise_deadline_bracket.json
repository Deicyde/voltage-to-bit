          "snippet": {
            "line": 100,
            "text": "theorem rise_deadline_bracket (τ : ℝ) :\n    (τ < 2.168 → ¬ ∀ (u v : ℝ → ℝ) (a b : ℝ), IsTrajectory illustrative u v a b →\n        v a ∈ Icc (-0.10 : ℝ) 2.08 →\n        ∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, u t ≤ 0.40) →\n          ∀ t ∈ Icc s e, s + τ ≤ t → 1.35 ≤ v t) ∧\n    (2.26 ≤ τ → ∀ (u v : ℝ → ℝ) (a b : ℝ), IsTrajectory illustrative u v a b →\n        v a ∈ Icc (-0.10 : ℝ) 2.08 →\n        ∀ s e : ℝ, a ≤ s → e ≤ b → (∀ t ∈ Ico s e, u t ≤ 0.40) →\n          ∀ t ∈ Icc s e, s + τ ≤ t → 1.35 ≤ v t) := by"
          },
          "declaration": {
            "id": "VoltageToBit.Examples.rise_deadline_bracket",
            "kind": "theorem"
          }
        }
      }
    }
