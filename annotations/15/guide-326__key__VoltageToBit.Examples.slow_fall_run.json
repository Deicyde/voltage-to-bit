          "snippet": {
            "line": 234,
            "text": "theorem slow_fall_run (v₀ : ℝ) (hv₀ : v₀ ∈ illustrative.Safe) :\n    ∃ v : ℝ → ℝ, v 0 = v₀ ∧\n      (∀ t ∈ Icc (0 : ℝ) 10,\n        HasDerivWithinAt v ((Inet slowDnCorner 1.25 (v t) + 2) / 20) (Icc 0 10) t) ∧\n      IsTrajectory illustrative (fun _ => 1.25) v 0 10 ∧\n      ∀ t ∈ Icc (0 : ℝ) 10, v₀ + -1.788 * t ≤ v t := by"
          },
          "declaration": {
            "id": "VoltageToBit.Examples.slow_fall_run",
            "kind": "theorem"
          }
        }
      }
