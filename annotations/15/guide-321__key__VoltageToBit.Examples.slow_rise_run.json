          "snippet": {
            "line": 111,
            "text": "theorem slow_rise_run (v₀ : ℝ) (hv₀ : v₀ ∈ illustrative.Safe) :\n    ∃ v : ℝ → ℝ, v 0 = v₀ ∧\n      (∀ t ∈ Icc (0 : ℝ) 10,\n        HasDerivWithinAt v ((Inet slowUpCorner 0.40 (v t) + -2) / 20) (Icc 0 10) t) ∧\n      IsTrajectory illustrative (fun _ => 0.40) v 0 10 ∧\n      ∀ t ∈ Icc (0 : ℝ) 10, v t ≤ v₀ + 0.6688 * t := by"
          },
          "declaration": {
            "id": "VoltageToBit.Examples.slow_rise_run",
            "kind": "theorem"
          }
        }
      }
