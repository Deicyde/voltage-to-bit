            "line": 153,
            "text": "theorem rise_deadline_counterexample {τ : ℝ} (hτ : τ < 2.168) :\n    ∃ (u v : ℝ → ℝ) (t : ℝ),\n      IsTrajectory illustrative u v 0 10 ∧ v 0 ∈ illustrative.Safe ∧\n      (∀ s ∈ Ico (0 : ℝ) 10, u s ≤ illustrative.VIL) ∧\n      t ∈ Icc (0 : ℝ) 10 ∧ 0 + τ ≤ t ∧ v t < illustrative.VOH := by"
          },
