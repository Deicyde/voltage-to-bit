            "line": 276,
            "text": "theorem fall_deadline_counterexample {τ : ℝ} (hτ : τ < 1.0234) :\n    ∃ (u v : ℝ → ℝ) (t : ℝ),\n      IsTrajectory illustrative u v 0 10 ∧ v 0 ∈ illustrative.Safe ∧\n      (∀ s ∈ Ico (0 : ℝ) 10, illustrative.VIH ≤ u s) ∧\n      t ∈ Icc (0 : ℝ) 10 ∧ 0 + τ ≤ t ∧ illustrative.VOL < v t := by"
          },
          "declaration": {
