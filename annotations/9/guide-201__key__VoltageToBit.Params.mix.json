          "snippet": {
            "line": 116,
            "text": "def Params.mix (θ₁ θ₂ : Params) (s : ℝ) : Params where\n  VDD := θ₁.VDD + s * (θ₂.VDD - θ₁.VDD)\n  kn := θ₁.kn + s * (θ₂.kn - θ₁.kn)\n  kp := θ₁.kp + s * (θ₂.kp - θ₁.kp)\n  Vtn := θ₁.Vtn + s * (θ₂.Vtn - θ₁.Vtn)\n  Vtp := θ₁.Vtp + s * (θ₂.Vtp - θ₁.Vtp)"
          },
