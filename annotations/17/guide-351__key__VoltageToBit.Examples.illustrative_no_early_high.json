          "snippet": {
            "line": 105,
            "text": "theorem illustrative_no_early_high (u v : ℝ → ℝ)\n    (a b : ℝ) (h : IsTrajectory illustrative u v a b) (h0 : v a ∈ illustrative.Safe)\n    (s e : ℝ) (hs : a ≤ s) (he : e ≤ b) (hu : ∀ t ∈ Ico s e, 0 ≤ u t ∧ u t ≤ 0.40)\n    (hvs : v s ≤ 0.25) :\n    ∀ t ∈ Icc s e, t ≤ s + 0.038 → v t < 1.35 := by"
          },
