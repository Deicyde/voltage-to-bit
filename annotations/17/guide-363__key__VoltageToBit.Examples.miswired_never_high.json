          "snippet": {
            "line": 384,
            "text": "theorem miswired_never_high {u v : ℝ → ℝ} {a b : ℝ}\n    (hcont : ContinuousOn v (Icc a b))\n    (hincl : ∀ t ∈ Ico a b, ∃ v' c : ℝ, HasDerivWithinAt v v' (Ici t) t ∧\n      (5 : ℝ) ≤ c ∧ c ≤ 20 ∧ |c * v' - InetSwapped nominal (u t) (v t)| ≤ 2)\n    (hu : ∀ t ∈ Ico a b, u t ≤ 0.40) (h0 : v a < 1.35) :\n    ∀ t ∈ Icc a b, v t < 1.35 := by"
          },
          "declaration": {
