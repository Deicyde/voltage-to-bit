            "line": 201,
            "text": "theorem valid_low_input_can_give_valid_high_within_38ps :\n    ∃ v : ℝ → ℝ, v 0 = 0.25 ∧\n      (∀ t ∈ Icc (0 : ℝ) 10,\n        HasDerivWithinAt v ((Inet fastUp (-1) (v t) + 0) / 5) (Icc 0 10) t) ∧\n      IsTrajectory illustrative (fun _ => -1) v 0 10 ∧ 1.35 ≤ v 0.038 := by"
          },
