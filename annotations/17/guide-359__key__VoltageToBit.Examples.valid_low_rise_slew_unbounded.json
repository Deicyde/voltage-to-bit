            "text": "theorem valid_low_rise_slew_unbounded (M : ℝ) :\n    ∃ (u v : ℝ → ℝ) (d : ℝ), (∀ t, u t ≤ 0.40) ∧ v 0 = 0.25 ∧\n      IsTrajectory illustrative u v 0 10 ∧ HasDerivWithinAt v d (Ici 0) 0 ∧ M < d := by"
