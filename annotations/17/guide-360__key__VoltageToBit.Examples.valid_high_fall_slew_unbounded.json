            "text": "theorem valid_high_fall_slew_unbounded (M : ℝ) :\n    ∃ (u v : ℝ → ℝ) (d : ℝ), (∀ t, 1.25 ≤ u t) ∧ v 0 = 1.35 ∧\n      IsTrajectory illustrative u v 0 10 ∧ HasDerivWithinAt v d (Ici 0) 0 ∧ d < -M := by"
