/-- Namespaces in which a name quoted in the prose may live. -/
def nss : List Name := [.anonymous, `VoltageToBit, `VoltageToBit.Examples, `VoltageToBit.IsTrajectory,
  `VoltageToBit.Design, `VoltageToBit.Design.Admissible, `VoltageToBit.Design.InBox, `VoltageToBit.Params]

elab "#check_doc_names" : command => do
  let env ← getEnv
  let mut missing : Array String := #[]
  let mut found : Nat := 0
  for s in docNames do
    let n := s.toName
    if nss.any (fun ns => env.contains (ns ++ n)) then found := found + 1
    else missing := missing.push s
  logInfo m!"names quoted in the prose that resolve to a declaration: {found}"
  logInfo m!"quoted names that do NOT resolve (inspect by hand; many are not meant as Lean names): {missing}"

#check_doc_names
